<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata schemaVersion="2">
    <id>DapperExtensions.StrongName</id>
    <version>1.7.2-patch5.Debug</version>
    <authors>Thad Smith, Page Brooks</authors>
    <owners>Thad Smith, Page Brooks</owners>
    <licenseUrl>http://www.apache.org/licenses/LICENSE-2.0</licenseUrl>
    <projectUrl>https://github.com/Spectrum-Dynamics/SD.Dapper-Extensions</projectUrl>
    <!--<iconUrl>http://ICON_URL_HERE_OR_DELETE_THIS_LINE</iconUrl>-->
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>A small library that complements Dapper by adding basic CRUD operations (Get, Insert, Update, Delete) for your POCOs. For more advanced querying scenarios, Dapper Extensions provides a predicate system.</description>
    <releaseNotes>
      1.7.2
      * update slapper.mapper refs
      * fix issue with update with ignore keys
      1.7.0
      * Forked from orginal project of Thad Smith
      * Implemented Code Coverage to the Tests
      * Migrate tests connection strings to JSon
      * Unified NetCore and NetFramework projects to use a simple multi-target projects
      * Multiple enhancements to the code
      * Implemented multi-level predicate support
      * .Net Standard 2.0 compliance
      1.6.1
      * Added Oracle Dialect to 4.5
      1.6.0
      * Added DB2 Dialect
      * Added flag to ignore All Key fields when doing an update
      * Added missing async/await methods
      * Added unmap method to Mapper
    </releaseNotes>
    <tags>orm sql micro-orm Data Dapper</tags>
    <dependencies>
      <dependency id="Dapper.StrongName" version="[2.0.30)" />
      <dependency id="SD.Slapper.AutoMapper.Strongname" version="[2.0.5)" />
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Core"/>
      <frameworkAssembly assemblyName="System"/>
      <frameworkAssembly assemblyName="System.Data"/>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.0-Client, .NETFramework4.0" />
    </frameworkAssemblies>
  </metadata>
  <files>
	  <file src="bin\Debug\472\SD.DapperExtensions.StrongName.dll" target="lib\net472\SD.DapperExtensions.StrongName.dll" />
	  <file src="bin\Debug\472\SD.DapperExtensions.StrongName.pdb" target="lib\net472\SD.DapperExtensions.StrongName.pdb" />
	  <file src="bin\Debug\netcoreapp3.1\SD.DapperExtensions.StrongName.dll" target="lib\netcoreapp3.1\SD.DapperExtensions.StrongName.dll" />
	  <file src="bin\Debug\net6.0\SD.DapperExtensions.StrongName.dll" target="lib\net5.0\SD.DapperExtensions.StrongName.dll" />
	  <file src="bin\Debug\netstandard2.1\SD.DapperExtensions.StrongName.dll" target="lib\netstandard2.1\SD.DapperExtensions.StrongName.dll" />
  </files>
</package>